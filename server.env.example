# Copy to .env next to relay.mjs. Only .env contains your real values.
# Replace with the compatible school or provider gateway that serves the chosen model.
UPSTREAM_BASE_URL=https://your-gateway.example/v1
UPSTREAM_MODEL=openai/gpt-6-luna
UPSTREAM_API_KEY=
PORT=8787
REQUESTS_PER_HOUR=60
MAX_OUTPUT_TOKENS=2500
# For gateways that require the older name, set this to max_tokens.
TOKEN_LIMIT_FIELD=max_completion_tokens
# Local teacher demo: leave all three blank.
# School HTTPS gateway: exact Pages origin, a fresh random class token, a future ISO UTC expiry.
ALLOWED_ORIGIN=
CLASS_TOKEN=
CLASS_TOKEN_EXPIRES=

# Optional extra words/phrases for your classroom, separated by commas.
CLASSROOM_BLOCKED_TERMS=
